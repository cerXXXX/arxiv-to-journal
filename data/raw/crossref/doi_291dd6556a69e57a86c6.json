{"status":"ok","message-type":"work","message-version":"1.0.0","message":{"indexed":{"date-parts":[[2026,7,6]],"date-time":"2026-07-06T18:56:40Z","timestamp":1783364200788,"version":"3.54.6"},"reference-count":27,"publisher":"Oxford University Press (OUP)","issue":"2","license":[{"start":{"date-parts":[[2022,1,8]],"date-time":"2022-01-08T00:00:00Z","timestamp":1641600000000},"content-version":"vor","delay-in-days":0,"URL":"https:\/\/creativecommons.org\/licenses\/by\/4.0\/"}],"funder":[{"name":"SCOAP"}],"content-domain":{"domain":[],"crossmark-restriction":false},"short-container-title":[],"published-print":{"date-parts":[[2022,2,17]]},"abstract":"<jats:title>Abstract<\/jats:title>\n               <jats:p>We formulate quantum electrodynamics on the basis of gauge (or BRST) covariant diffusion equations\u00a0of fields. This is a particular example of the gradient flow exact renormalization group (GFERG). The resulting Wilson action fulfills a simple gauge Ward\u2013Takahashi identity. We solve the GFERG equation\u00a0around the Gaussian fixed point to the second order in gauge coupling and obtain the 1-loop beta function and anomalous dimensions. The anomalous dimension of the electron field coincides with that of the fermion field diffused by a gauge covariant flow equation\u00a0of L\u00fcscher.<\/jats:p>","DOI":"10.1093\/ptep\/ptac003","type":"journal-article","created":{"date-parts":[[2022,1,6]],"date-time":"2022-01-06T12:14:20Z","timestamp":1641471260000},"source":"Crossref","is-referenced-by-count":8,"title":["Manifestly gauge invariant exact renormalization group for quantum electrodynamics"],"prefix":"10.1093","volume":"2022","author":[{"given":"Yuki","family":"Miyakawa","sequence":"first","affiliation":[{"name":"Department of Physics, Kyushu University, 744 Motooka, Nishi-ku, Fukuoka 819-0395, Japan"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Hidenori","family":"Sonoda","sequence":"additional","affiliation":[{"name":"Physics Department, Kobe University, Kobe 657-8501, Japan"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Hiroshi","family":"Suzuki","sequence":"additional","affiliation":[{"name":"Department of Physics, Kyushu University, 744 Motooka, Nishi-ku, Fukuoka 819-0395, Japan"}],"role":[{"vocabulary":"crossref","role":"author"}]}],"member":"286","published-online":{"date-parts":[[2022,1,8]]},"reference":[{"key":"2022031710405225600_bib1","doi-asserted-by":"crossref","first-page":"75","DOI":"10.1016\/0370-1573(74)90023-4","volume":"12","author":"Wilson","year":"1974","journal-title":"Phys. Rept."},{"key":"2022031710405225600_bib2","doi-asserted-by":"crossref","first-page":"9675","DOI":"10.1088\/1751-8113\/40\/31\/034","volume":"40","author":"Sonoda","year":"2007","journal-title":"J. Phys. A"},{"key":"2022031710405225600_bib3","doi-asserted-by":"crossref","first-page":"1","DOI":"10.1143\/PTPS.181.1","volume":"181","author":"Igarashi","year":"2010","journal-title":"Prog. Theor. Phys. Suppl."},{"key":"2022031710405225600_bib4","author":"Becchi"},{"key":"2022031710405225600_bib5","doi-asserted-by":"crossref","first-page":"364","DOI":"10.1016\/0370-2693(94)90365-4","volume":"335","author":"Ellwanger","year":"1994","journal-title":"Phys. Lett. B"},{"key":"2022031710405225600_bib6","doi-asserted-by":"crossref","first-page":"87","DOI":"10.1016\/0370-2693(94)01676-4","volume":"346","author":"Bonini","year":"1995","journal-title":"Phys. Lett. B"},{"key":"2022031710405225600_bib7","doi-asserted-by":"crossref","first-page":"163","DOI":"10.1016\/0550-3213(94)00569-Z","volume":"437","author":"Bonini","year":"1995","journal-title":"Nucl. Phys. B"},{"key":"2022031710405225600_bib8","doi-asserted-by":"crossref","first-page":"181","DOI":"10.1016\/0550-3213(94)90543-6","volume":"417","author":"Reuter","year":"1994","journal-title":"Nucl. Phys. B"},{"key":"2022031710405225600_bib9","doi-asserted-by":"crossref","first-page":"291","DOI":"10.1016\/0550-3213(94)90278-X","volume":"427","author":"Reuter