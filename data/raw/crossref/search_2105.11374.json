. Here the method of finding the Green function itself can be arbitrary (whether or not it is associated with summation over modes).<\/jats:p>","DOI":"10.1093\/oso\/9780198539988.003.0002","type":"book-chapter","created":{"date-parts":[[2023,11,5]],"date-time":"2023-11-05T14:58:05Z","timestamp":1699196285000},"page":"24-55","source":"Crossref","is-referenced-by-count":0,"title":["The Casimir effect for various fields and spatial domains"],"prefix":"10.1093","author":[{"given":"V M","family":"Mostepanenko","sequence":"first","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"N N","family":"Trunov","sequence":"additional","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"R L","family":"Znajek","sequence":"additional","affiliation":[{"name":"Department of Physics, Federal University of Paraiba, Brazil"},{"name":"St Petersburg State Technological Institute"},{"name":"A. Friedmann Laboratory for Theoretical Physics, Russia"},{"name":"D. I. Mendeleev Scientific Research Institute for Metrology, St Petersburg, Russia"}],"role":[{"role":"author","vocabulary":"crossref"}]}],"member":"286","container-title":["The Casimir Effect and its Applications"],"language":"en","link":[{"URL":"https:\/\/academic.oup.com\/book\/chapter-pdf\/52582993\/isbn-9780198539988-book-part-2.pdf","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}],"deposited":{"date-parts":[[2025,10,23]],"date-time":"2025-10-23T19:16:25Z","timestamp":1761246985000},"score":22.242233,"resource":{"primary":{"URL":"https:\/\/academic.oup.com\/book\/54733\/chapter\/422681693"}},"issued":{"date-parts":[[1997,1,30]]},"ISBN":["9780198539988","9781383026801"],"references-count":0,"URL":"https:\/\/doi.org\/10.1093\/oso\/9780198539988.003.0002","published":{"date-parts":[[1997,1,30]]}},{"indexed":{"date-parts":[[2026,2,5]],"date-time":"2026-02-05T21:19:33Z","timestamp":1770326373873,"version":"3.49.0"},"reference-count":20