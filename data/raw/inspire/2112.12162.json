ue":"grid.266539.d"},{"schema":"ROR","value":"https://ror.org/02k3smh20"}],"full_name":"Dymarsky, Anatoly","record":{"$ref":"https://inspirehep.net/api/authors/1032584"},"ids":[{"schema":"INSPIRE BAI","value":"A.Dymarsky.1"}],"signature_block":"DANARSCYa","first_name":"Anatoly","recid":1032584},{"raw_affiliations":[{"value":"CTP and Department of Physics and Astronomy, Queen Mary University of London, E1 4NS London, UK"}],"full_name_unicode_normalized":"radhakrishnan, rajath","last_name":"Radhakrishnan","affiliations":[{"curated_relation":true,"record":{"$ref":"https://inspirehep.net/api/institutions/903146"},"value":"Queen Mary, U. of London"}],"uuid":"c47f4062-e6c0-4108-8005-e897c765223e","affiliations_identifiers":[{"schema":"GRID","value":"grid.4868.2"},{"schema":"ROR","value":"https://ror.org/026zzn846"}],"full_name":"Radhakrishnan, Rajath","curated_relation":true,"record":{"$ref":"https://inspirehep.net/api/authors/1775981"},"ids":[{"schema":"ORCID","value":"0000-0003-1158-3320"},{"schema":"INSPIRE BAI","value":"Rajath.Radhakrishnan.1"}],"signature_block":"RADACRASNANr","first_name":"Rajath","recid":1775981}],"imprints":[{"date":"2023-03-02"}],"abstracts":[{"source":"Springer","value":"We give a general construction relating Narain rational conformal field theories (RCFTs) and associated 3d Chern-Simons (CS) theories to quantum stabilizer codes. Starting from an abelian CS theory with a fusion group consisting of n even-order factors, we map a boundary RCFT to an n-qubit quantum code. When the relevant ’t Hooft anomalies vanish, we can orbifold our RCFTs and describe this gauging at the level of the code. Along the way, we give CFT interpretations of the code subspace and the Hilbert space of qubits while mapping error operations to CFT defect fields.","abstract_source_suggest":{"input":"Springer"}},{"source":"arXiv","value":"We give a general construction relating Narain rational conformal field theories (RCFTs) and associated 3d Chern-Simons (CS) theories to quantum stabilizer codes. Starting from an abelian CS theory with a fusion group consisting of $n$ even-order factors, we map a boundary RCFT to an $n$-qubit quantum code. When the relevant 't Hooft anomalies vanish, we can orbifold our RCFTs and describe this gauging at the level of the code. Along the way, we give CFT interpretations of the code subspace and the Hilbert space of qubits while mapping error operations to CFT defect fields.","abstract_source_suggest":{"input":"arXiv"}}],"control_number":1996612,"dois":[{"source":"Springer","value":"10.1007/JHEP03(2023)017"}],"preprint_date":"2021-12-22","arxiv_eprints":[{"categories":["hep-th","cond-mat.str-el","quant-ph"],"value":"2112.12162"}],"titles":[{"source":"Springer","title":"Quantum codes, CFTs, and defects"},{"source":"arXiv","title":"Quantum Codes, CFTs, and Defects"}],"document_type":["article"]}}],"total":1},"links":{"self":"https://inspirehep.net/api/literature/?q=arxiv%3A2112.12162&size=5&page=1&fields=titles,authors,dois,publication_info,arxiv_eprints,document_type,preprint_date,imprints,abstracts,urls","bibtex":"https://inspirehep.net/api/literature/?q=arxiv%3A2112.12162&size=5&page=1&format=bibtex","latex-eu":"https://inspirehep.net/api/literature/?q=arxiv%3A2112.12162&size=5&page=1&format=latex-eu","latex-us":"https://inspirehep.net/api/literature/?q=arxiv%3A2112.12162&size=5&page=1&format=latex-us","json":"https://inspirehep.net/api/literature/?q=arxiv%3A2112.12162&size=5&page=1&fields=titles,authors,dois,publication_info,arxiv_eprints,document_type,preprint_date,imprints,abstracts,urls&format=json","json-expanded":"https://inspirehep.net/api/literature/?q=arxiv%3A2112.12162&size=5&page=1&format=json-expanded","cv":"https://inspirehep.net/api/literature/?q=arxiv%3A2112.12162&size=5&page=1&format=cv"}}