","value":"https://ror.org/013w2d378"}],"full_name":"Nekrasov, Nikita","curated_relation":true,"record":{"$ref":"https://inspirehep.net/api/authors/995909"},"ids":[{"schema":"ORCID","value":"0000-0002-1266-6788"},{"schema":"INSPIRE BAI","value":"Nikita.Nekrasov.1"}],"signature_block":"NACRASAVn","first_name":"Nikita","recid":995909},{"raw_affiliations":[{"value":"Department of Physics and Astronomy, Uppsala University, Box 516, SE-75120 Uppsala, Sweden"}],"full_name_unicode_normalized":"piazzalunga, nicolo'","last_name":"Piazzalunga","affiliations":[{"record":{"$ref":"https://inspirehep.net/api/institutions/903314"},"value":"Uppsala U."}],"uuid":"c5106382-e7cf-4bfa-8336-0ba66142dd6c","affiliations_identifiers":[{"schema":"GRID","value":"grid.8993.b"},{"schema":"ROR","value":"https://ror.org/048a87296"}],"full_name":"Piazzalunga, Nicolo'","curated_relation":true,"record":{"$ref":"https://inspirehep.net/api/authors/1299516"},"ids":[{"schema":"ORCID","value":"0000-0002-0602-9424"},{"schema":"INSPIRE BAI","value":"N.Piazzalunga.1"}],"signature_block":"PASALANGn","first_name":"Nicolo'","recid":1299516},{"raw_affiliations":[{"value":"Department of Physics and Astronomy, Uppsala University, Box 516, SE-75120 Uppsala, Sweden"}],"affiliations_identifiers":[{"schema":"GRID","value":"grid.8993.b"},{"schema":"ROR","value":"https://ror.org/048a87296"}],"full_name_unicode_normalized":"zabzine, maxim","full_name":"Zabzine, Maxim","record":{"$ref":"https://inspirehep.net/api/authors/982459"},"last_name":"Zabzine","ids":[{"schema":"INSPIRE BAI","value":"M.Zabzine.1"}],"affiliations":[{"record":{"$ref":"https://inspirehep.net/api/institutions/903314"},"value":"Uppsala U."}],"signature_block":"ZABSANm","first_name":"Maxim","uuid":"ab4291bd-f2c8-4b66-b673-246796ac10bf","recid":982459}],"imprints":[{"date":"2022-08-23"}],"abstracts":[{"source":"Springer","value":"Motivated by M-theory, we study rank n K-theoretic Donaldson–Thomas theory on a toric threefold X. In the presence of compact four-cycles, we discuss how to include the contribution of D4-branes wrapping them. Combining this with a simple assumption on the (in)dependence on Coulomb moduli in the 7d theory, we show that the partition function factorizes and, when X is Calabi–Yau and it admits an ADE ruling, it reproduces the 5d master formula for the geometrically engineered theory on $A_{n-1}$ ALE space, thus extending the usual geometric engineering dictionary to $n>1$. We finally speculate about implications for instanton counting on Taub-NUT.","abstract_source_suggest":{"input":"Springer"}},{"source":"arXiv","value":"Motivated by M-theory, we study rank $n$ K-theoretic Donaldson-Thomas theory on a toric threefold $X$. In the presence of compact four-cycles, we discuss how to include the contribution of D4-branes wrapping them. Combining this with a simple assumption on the (in)dependence on Coulomb moduli in the 7d theory, we show that the partition function factorizes and, when $X$ is Calabi-Yau and it admits an ADE ruling, it reproduces the 5d master formula for the geometrically engineered theory on $A$$_{n-}$ ALE space, thus extending the usual geometric engineering dictionary to $n$ > 1. We finally speculate about implications for instanton counting on Taub-NUT.","abstract_source_suggest":{"input":"arXiv"}}],"control_number":1852302,"dois":[{"source":"Springer","value":"10.1007/s00220-022-04479-7"},{"material":"publication","source":"arXiv","value":"10.1007/s00220-022-04479-7"}],"preprint_date":"2021-03-18","arxiv_eprints":[{"categories":["hep-th","math.AG"],"value":"2103.10271"}],"titles":[{"source":"Springer","title":"Playing With the Index of M-Theory"},{"source":"arXiv","title":"Playing with the index of M-theory"}],"document_type":["article"]},"id":"1852302","links":{"bibtex":"https://inspirehep.net/api/literature/1852302?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/1852302?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/1852302?format=l