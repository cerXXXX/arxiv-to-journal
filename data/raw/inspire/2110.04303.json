{"hits":{"hits":[{"created":"2021-10-12T03:00:18.505496+00:00","updated":"2023-03-09T19:45:53.674089+00:00","links":{"bibtex":"https://inspirehep.net/api/literature/1941254?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/1941254?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/1941254?format=latex-us","json":"https://inspirehep.net/api/literature/1941254?format=json","json-expanded":"https://inspirehep.net/api/literature/1941254?format=json-expanded","cv":"https://inspirehep.net/api/literature/1941254?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A1941254"},"metadata":{"authors":[{"raw_affiliations":[{"value":"Department of Physics, Boston University 590 Commonwealth Avenue, Boston, MA 02215, USA"}],"full_name_unicode_normalized":"cogburn, cameron v.","full_name":"Cogburn, Cameron V.","record":{"$ref":"https://inspirehep.net/api/authors/1511966"},"affiliations":[{"record":{"$ref":"https://inspirehep.net/api/institutions/902680"},"value":"Boston U."}],"last_name":"Cogburn","ids":[{"schema":"INSPIRE BAI","value":"C.Cogburn.1"}],"signature_block":"CAGBARNc","uuid":"5dcc44ef-d22f-4dc7-bec0-087459043a3a","first_name":"Cameron V.","recid":1511966}],"abstracts":[{"source":"arXiv","value":"We study non-Gaussian bulk 2d CFTs in AdS$_2$ using boundary CFT techniques and recent results in JT/Schwarzian gravity. We highlight the constraints on the operator content of a theory imposed by the boundary conditions by examining the relation between correlator coefficients and OPE coefficients in the presence of a boundary. We then calculate bulk and boundary correlators for various boundary conditions. Schwarzian techniques are used to calculate gravitational correlators perturbatively in $1/c$.","abstract_source_suggest":{"input":"arXiv"}}],"control_number":1941254,"preprint_date":"2021-10-08","titles":[{"source":"arXiv","title":"CFT$_2$ in the Bulk"}],"arxiv_eprints":[{"categories":["hep-th"],"value":"2110.04303"}],"document_type":["article"]},"id":"1941254"}],"total":1},"links":{"self":"https://inspirehep.net/api/literature/?q=arxiv%3A2110.04303&size=5&page=1&fields=titles,authors,dois,publication_info,arxiv_eprints,document_type,preprint_date,imprints,abstracts,urls","bibtex":"https://inspirehep.net/api/literature/?q=arxiv%3A2110.04303&size=5&page=1&format=bibtex","latex-eu":"https://inspirehep.net/api/literature/?q=arxiv%3A2110.04303&size=5&page=1&format=latex-eu","latex-us":"https://inspirehep.net/api/literature/?q=arxiv%3A2110.04303&size=5&page=1&format=latex-us","json":"https://inspirehep.net/api/literature/?q=arxiv%3A2110.04303&size=5&page=1&fields=titles,authors,dois,publication_info,arxiv_eprints,document_type,preprint_date,imprints,abstracts,urls&format=json","json-expanded":"https://inspirehep.net/api/literature/?q=arxiv%3A2110.04303&size=5&page=1&format=json-expanded","cv":"https://inspirehep.net/api/literature/?q=arxiv%3A2110.04303&size=5&page=1&format=cv"}}