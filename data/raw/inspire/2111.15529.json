te":"2022-02-25"}],"abstracts":[{"source":"Oxford University Press","value":"We formulate quantum electrodynamics on the basis of gauge (or BRST) covariant diffusion equations of fields. This is a particular example of the gradient flow exact renormalization group (GFERG). The resulting Wilson action fulfills a simple gauge Ward–Takahashi identity. We solve the GFERG equation around the Gaussian fixed point to the second order in gauge coupling and obtain the 1-loop beta function and anomalous dimensions. The anomalous dimension of the electron field coincides with that of the fermion field diffused by a gauge covariant flow equation of Lüscher.","abstract_source_suggest":{"input":"Oxford University Press"}},{"source":"arXiv","value":"We formulate quantum electrodynamics on the basis of gauge (or BRST) covariant diffusion equations of fields. This is a particular example of the gradient flow exact renormalization group (GFERG). The resulting Wilson action fulfills a simple gauge Ward--Takahashi identity. We solve the GFERG equation around the Gaussian fixed point to the second order in gauge coupling and obtain the 1-loop beta function and anomalous dimensions. The anomalous dimension of the electron field coincides with that of the fermion field diffused by a gauge covariant flow equation of Lüscher.","abstract_source_suggest":{"input":"arXiv"}}],"control_number":1980688,"dois":[{"source":"Oxford University Press","value":"10.1093/ptep/ptac003"}],"preprint_date":"2021-11-30","arxiv_eprints":[{"categories":["hep-th","hep-lat"],"value":"2111.15529"}],"titles":[{"source":"Oxford University Press","title":"Manifestly gauge invariant exact renormalization group for quantum electrodynamics"},{"source":"arXiv","title":"Manifestly gauge invariant exact renormalization group for quantum electrodynamics"}],"document_type":["article"]},"id":"1980688","created":"2021-12-01T03:00:00.695417+00:00","links":{"bibtex":"https://inspirehep.net/api/literature/1980688?format=bibtex","l