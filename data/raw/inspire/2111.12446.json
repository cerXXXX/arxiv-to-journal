{"hits":{"hits":[{"updated":"2023-11-23T10:28:58.778734+00:00","created":"2021-11-25T02:56:12.268973+00:00","metadata":{"publication_info":[{"journal_volume":"82","artid":"545","year":2022,"journal_record":{"$ref":"https://inspirehep.net/api/journals/1613946"},"page_start":"545","journal_issue":"6","journal_title":"Eur.Phys.J.C"}],"authors":[{"raw_affiliations":[{"value":"Department of Nuclear and Particle Physics, Faculty of Physics, National and Kapodistrian University of Athens, 15784 Athens, Greece"},{"value":"Instituto de Física, Universidade de São Paulo, Rua do Matão Travessa 1371, 05508-090 São Paulo, SP, Brazil"}],"full_name_unicode_normalized":"katsinis, dimitrios","last_name":"Katsinis","affiliations":[{"record":{"$ref":"https://inspirehep.net/api/institutions/902653"},"value":"Athens U."},{"record":{"$ref":"https://inspirehep.net/api/institutions/903186"},"value":"Sao Paulo U."}],"uuid":"478d6797-4c8b-4f96-8490-d031d803b9c7","affiliations_identifiers":[{"schema":"GRID","value":"grid.5216.0"},{"schema":"GRID","value":"grid.11899.38"},{"schema":"ROR","value":"https://ror.org/04gnjpq42"},{"schema":"ROR","value":"https://ror.org/036rp1748"}],"full_name":"Katsinis, Dimitrios","record":{"$ref":"https://inspirehep.net/api/authors/1635409"},"ids":[{"schema":"ORCID","value":"0000-0001-5607-9625"},{"schema":"INSPIRE BAI","value":"D.Katsinis.1"}],"signature_block":"CATSANd","first_name":"Dimitrios","recid":1635409},{"raw_affiliations":[{"value":"Department of Nuclear and Particle Physics, Faculty of Physics, National and Kapodistrian University of Athens, 15784 Athens, Greece"}],"full_name_unicode_normalized":"panopoulos, pantelis","last_name":"Panopoulos","affiliations":[{"curated_relation":true,"record":{"$ref":"https://inspirehep.net/api/institutions/902653"},"value":"Athens U."}],"uuid":"f547f5e0-5791-4d29-a87c-9a12513e089b","affiliations_identifiers":[{"schema":"GRID","value":"grid.5216.0"},{"schema":"ROR","value":"https://ror.org/04gnjpq42"}],"full_name":"Panopoulos, Pantelis","record":{"$ref":"https://inspirehep.net/api/authors/1752854"},"ids":[{"schema":"INSPIRE BAI","value":"Pantelis.Panopoulos.1"}],"signature_block":"PANAPALp","first_name":"Pantelis","recid":1752854}],"imprints":[{"date":"2022-06-21"}],"abstracts":[{"source":"Springer","value":"We obtain classical solutions of $\\lambda $-deformed $\\sigma $-models based on $SL(2,{\\mathbb {R}})/U(1)$ and SU(2)/U(1) coset manifolds. Using two different sets of coordinates, we derive two distinct classes of solutions. The first class is expressed in terms of hyperbolic and trigonometric functions, whereas the second one in terms of elliptic functions. We analyze their properties along with the boundary conditions and discuss string systems that they describe. It turns out that there is an apparent similarity between the solutions of the second class and the motion of a pendulum.","abstract_source_suggest":{"input":"Springer"}},{"source":"arXiv","value":"We obtain classical solutions of $\\l$-deformed $\\s$-models based on $SL(2,\\mathbb{R})/U(1)$ and $SU(2)/U(1)$ coset manifolds. Using two different sets of coordinates, we derive two distinct classes of solutions. The first class is expressed in terms of hyperbolic and trigonometric functions, whereas the second one in terms of elliptic functions. We analyze their properties along with the boundary conditions and discuss string systems that they describe. It turns out that there is an apparent similarity between the solutions of the second class and the motion of a pendulum.","abstract_source_suggest":{"input":"arXiv"}}],"control_number":1975488,"dois":[{"source":"Springer","value":"10.1140/epjc/s10052-022-10493-9"},{"material":"publication","source":"arXiv","value":"10.1140/epjc/s10052-022-10493-9"}],"preprint_date":"2021-11-24","arxiv_eprints":[{"categories":["hep-th","math-ph","math.MP","nlin.SI"],"value":"2111.12446"}],"titles":[{"source":"Springer","title":"Classical solutions of $\\lambda $-deformed coset models"},{"source":"arXiv","title":"Classical solutions of $\\lambda$-deformed coset models"}],"document_type":["article"]},"id":"1975488","links":{"bibtex":"https://inspirehep.net/api/literature/1975488?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/1975488?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/1975488?format=latex-us","json":"https://inspirehep.net/api/literature/1975488?format=json","json-expanded":"https://inspirehep.net/api/literature/1975488?format=json-expanded","cv":"https://inspirehep.net/api/literature/1975488?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A1975488"}}],"total":1},"links":{"self":"https://inspirehep.net/api/literature/?q=arxiv%3A2111.12446&size=5&page=1&fields=titles,authors,dois,publication_info,arxiv_eprints,document_type,preprint_date,imprints,abstracts,urls","bibtex":"https://inspirehep.net/api/literature/?q=arxiv%3A2111.12446&size=5&page=1&format=bibtex","latex-eu":"https://inspirehep.net/api/literature/?q=arxiv%3A2111.12446&size=5&page=1&format=latex-eu","latex-us":"https://inspirehep.net/api/literature/?q=arxiv%3A2111.12446&size=5&page=1&format=latex-us","json":"https://inspirehep.net/api/literature/?q=arxiv%3A2111.12446&size=5&page=1&fields=titles,authors,dois,publication_info,arxiv_eprints,document_type,preprint_date,imprints,abstracts,urls&format=json","json-expanded":"https://inspirehep.net/api/literature/?q=arxiv%3A2111.12446&size=5&page=1&format=json-expanded","cv":"https://inspirehep.net/api/literature/?q=arxiv%3A2111.12446&size=5&page=1&format=cv"}}