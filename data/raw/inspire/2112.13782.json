e":"Fudan U."}],"last_name":"Zhou","uuid":"efc2033b-d044-4b4a-928d-3118722cb724","affiliations_identifiers":[{"schema":"GRID","value":"grid.8547.e"},{"schema":"ROR","value":"https://ror.org/013q1eq08"}],"full_name":"Zhou, Shuyan","curated_relation":true,"record":{"$ref":"https://inspirehep.net/api/authors/2842720"},"ids":[{"schema":"INSPIRE BAI","value":"S.Zhou.12"}],"signature_block":"Zs","first_name":"Shuyan","recid":2842720},{"raw_affiliations":[{"value":"Department of Physics, Fudan University, 200433 Shanghai, China"},{"value":"Center for Field Theory and Particle Physics, Fudan University, 200433 Shanghai, China"},{"value":"Peng Huanwu Center for Fundamental Theory, 230026 Hefei, Anhui, China"}],"full_name_unicode_normalized":"zhou, yang","affiliations":[{"record":{"$ref":"https://inspirehep.net/api/institutions/903628"},"value":"Fudan U."},{"record":{"$ref":"https://inspirehep.net/api/institutions/1392859"},"value":"USTC, Hefei"},{"record":{"$ref":"https://inspirehep.net/api/institutions/1781483"},"value":"PCFT, Hefei"}],"last_name":"Zhou","uuid":"3910109a-8808-4b7d-be6e-a87851dc7406","affiliations_identifiers":[{"schema":"GRID","value":"grid.8547.e"},{"schema":"GRID","value":"grid.511315.2"},{"schema":"ROR","value":"https://ror.org/013q1eq08"},{"schema":"ROR","value":"https://ror.org/04c4dkn09"},{"schema":"ROR","value":"https://ror.org/01s9dmg43"}],"full_name":"Zhou, Yang","curated_relation":true,"record":{"$ref":"https://inspirehep.net/api/authors/1242523"},"ids":[{"schema":"INSPIRE BAI","value":"Yang.Zhou.1"}],"signature_block":"Zy","first_name":"Yang","recid":1242523}],"imprints":[{"date":"2022-05-09"}],"abstracts":[{"source":"Springer","value":"Partial reduction is a Karch-Randall reduction for only part of the AdS region between finite tension brane and zero tension brane. This is interesting in AdS/BCFT where the AdS bulk contains a defect brane. We employ partial reduction for a AdS bulk with a brane evolving as a 2d Friedmann-Robertson-Walker (FRW) cosmology and demonstrate the equivalence between defect extremal surface and island formula for a large subregion fine grained entropy in boundary CFT. We then move to higher dimensions and demonstrate the existence of 4d massless graviton on AdS$_{4}$ brane in partial reduction. We also propose a partial reduction for a 4d FRW cosmology at defect brane and obtain the Newton constant by computing boundary entropy.","abstract_source_suggest":{"input":"Springer"}},{"source":"arXiv","value":"Partial reduction is a Randall-Sundrum reduction for only part of the AdS region between finite tension brane and zero tension brane. This is interesting in AdS/BCFT where the AdS bulk contains a defect brane. We employ partial reduction for a AdS bulk with a brane evolving as a $2d$ Friedmann-Robertson-Walker (FRW) cosmology and demonstrate the equivalence between defect extremal surface and island formula for a large subregion fine grained entropy in boundary CFT. We then move to higher dimensions and demonstrate the existence of $4d$ massless graviton on AdS$_4$ brane in partial reduction. We also propose a partial reduction for a $4d$ FRW cosmology at defect brane and obtain the Newton constant by computing boundary entropy.","abstract_source_suggest":{"input":"arXiv"}}],"control_number":1997203,"dois":[{"source":"Springer","value":"10.1007/JHEP05(2022)049"},{"material":"publication","source":"arXiv","value":"10.1007/JHEP05(2022)049"}],"preprint_date":"2021-12-27","arxiv_eprints":[{"categories":["hep-th","gr-qc","hep-ph"],"value":"2112.13782"}],"titles":[{"source":"Springer","title":"Partial reduction and cosmology at defect brane"},{"source":"arXiv","title":"Partial Reduction and Cosmology at Defect Brane"}],"document_type":["article"]},"id":"1997203","links":{"bibtex":"https://inspirehep.net/api/literature/1997203?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/1997203?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/1997203?format=latex-us"