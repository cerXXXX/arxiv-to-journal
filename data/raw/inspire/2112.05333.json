{"hits":{"hits":[{"created":"2021-12-13T02:58:29.990678+00:00","id":"1988068","updated":"2026-02-09T12:08:13.360162+00:00","links":{"bibtex":"https://inspirehep.net/api/literature/1988068?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/1988068?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/1988068?format=latex-us","json":"https://inspirehep.net/api/literature/1988068?format=json","json-expanded":"https://inspirehep.net/api/literature/1988068?format=json-expanded","cv":"https://inspirehep.net/api/literature/1988068?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A1988068"},"metadata":{"publication_info":[{"conference_record":{"$ref":"https://inspirehep.net/api/conferences/1940831"},"cnum":"C21-12-06.2"}],"authors":[{"affiliations_identifiers":[{"schema":"ROR","value":"https://ror.org/02t274463"}],"full_name_unicode_normalized":"han, xizhi","full_name":"Han, Xizhi","record":{"$ref":"https://inspirehep.net/api/authors/1900935"},"last_name":"Han","ids":[{"schema":"INSPIRE BAI","value":"X.Han.1"}],"affiliations":[{"record":{"$ref":"https://inspirehep.net/api/institutions/903889"},"value":"Santa Barbara, KITP"}],"signature_block":"HANx","first_name":"Xizhi","uuid":"be6864ec-7c20-412e-b1f8-d819ebf639ed","recid":1900935},{"full_name_unicode_normalized":"rinaldi, enrico","last_name":"Rinaldi","affiliations":[{"record":{"$ref":"https://inspirehep.net/api/institutions/911022"},"value":"Nishina Ctr., RIKEN"}],"uuid":"3fc96a9d-72a5-42a7-98ef-4f053158272c","affiliations_identifiers":[{"schema":"ROR","value":"https://ror.org/05tqx4s13"}],"full_name":"Rinaldi, Enrico","curated_relation":true,"record":{"$ref":"https://inspirehep.net/api/authors/1059041"},"ids":[{"schema":"ORCID","value":"0000-0003-4134-809X"},{"schema":"INSPIRE BAI","value":"E.Rinaldi.1"}],"signature_block":"RANALDe","first_name":"Enrico","recid":1059041}],"abstracts":[{"source":"arXiv","value":"Supersymmetric quantum gauge theories are important mathematical tools in high energy physics. As an example, supersymmetric matrix models can be used as a holographic description of quantum black holes. The wave function of such supersymmetric gauge theories is not known and it is challenging to obtain with traditional techniques. We employ a neural quantum state ansatz for the wave function of a supersymmetric matrix model and use a variational quantum Monte Carlo approach to discover the ground state of the system. We discuss the difficulty of including bosonic particles and fermionic particles, as well as gauge degrees of freedom.","abstract_source_suggest":{"input":"arXiv"}}],"control_number":1988068,"preprint_date":"2021-12-09","titles":[{"source":"arXiv","title":"Neural quantum states for supersymmetric quantum gauge theories"}],"arxiv_eprints":[{"categories":["hep-th","hep-lat","quant-ph"],"value":"2112.05333"}],"document_type":["conference paper"]}}],"total":1},"links":{"self":"https://inspirehep.net/api/literature/?q=arxiv%3A2112.05333&size=5&page=1&fields=titles,authors,dois,publication_info,arxiv_eprints,document_type,preprint_date,imprints,abstracts,urls","bibtex":"https://inspirehep.net/api/literature/?q=arxiv%3A2112.05333&size=5&page=1&format=bibtex","latex-eu":"https://inspirehep.net/api/literature/?q=arxiv%3A2112.05333&size=5&page=1&format=latex-eu","latex-us":"https://inspirehep.net/api/literature/?q=arxiv%3A2112.05333&size=5&page=1&format=latex-us","json":"https://inspirehep.net/api/literature/?q=arxiv%3A2112.05333&size=5&page=1&fields=titles,authors,dois,publication_info,arxiv_eprints,document_type,preprint_date,imprints,abstracts,urls&format=json","json-expanded":"https://inspirehep.net/api/literature/?q=arxiv%3A2112.05333&size=5&page=1&format=json-expanded","cv":"https://inspirehep.net/api/literature/?q=arxiv%3A2112.05333&size=5&page=1&format=cv"}}