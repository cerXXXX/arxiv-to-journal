ite and perfect tensor entanglement, and correspond to stages of unitary evaporation of old black holes.","abstract_source_suggest":{"input":"arXiv"}}],"control_number":1982881,"dois":[{"material":"publication","source":"arXiv","value":"10.1038/s42005-022-01019-6"},{"value":"10.1038/s42005-022-01019-6"}],"preprint_date":"2021-12-01","titles":[{"source":"arXiv","title":"Holographic Cone of Average Entropies"}],"arxiv_eprints":[{"categories":["hep-th","quant-ph"],"value":"2112.00763"}],"document_type":["article"]},"id":"1982881","links":{"bibtex":"https://inspirehep.net/api/literature/1982881?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/1982881?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/1982881?format=latex-us","json":"https://inspirehep.net/api/literature/1982881?format=json","json-expanded":"https://inspirehep.net/api/literature/1982881?format=json-expanded","cv":"https://inspirehep.net/api/literature/1982881?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A1982881"},"updated":"2025-10-04T12:36:44.609411+00:00"}],"total":1},"links":{"self":"https://inspirehep.net/api/literature/?q=arxiv%3A2112.00763&size=5&page=1&fields=titles,authors,dois,publication_info,arxiv_eprints,document_type,preprint_date,imprints,abstracts,urls","bibtex":"https://inspirehep.net/api/literature/?q=arxiv%3A2112.00763&size=5&page=1&format=bibtex","latex-eu":"https://inspirehep.net/api/literature/?q=arxiv%3A2112.00763&size=5&page=1&format=latex-eu","latex-us":"https://inspirehep.net/api/literature/?q=arxiv%3A2112.00763&size=5&page=1&format=latex-us","json":"https://inspirehep.net/api/literature/?q=arxiv%3A2112.00763&size=5&page=1&fields=titles,authors,dois,publication_info,arxiv_eprints,document_type,preprint_date,imprints,abstracts,urls&format=json","json-expanded":"https://inspirehep.net/api/literature/?q=arxiv%3A2112.00763&size=5&page=1&format=json-expanded","cv":"https://inspirehep.net/api/literature/?q=arxiv%3A2