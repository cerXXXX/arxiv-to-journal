e.Reffert.1"}],"last_name":"Reffert","affiliations":[{"record":{"$ref":"https://inspirehep.net/api/institutions/902668"},"value":"Bern U."}],"signature_block":"RAFADs","first_name":"Susanne","uuid":"cb010896-b0e2-4173-bc93-1db845fda05f","recid":1032077}],"imprints":[{"date":"2021-05-05"}],"abstracts":[{"source":"Springer","value":"We study the O(2N) model at criticality in three dimensions in the double scaling limit of large N and large charge. We show that the large-charge expansion is an asymptotic series, and we use resurgence techniques to study the non-perturbative corrections and to extend the validity of the eft to any value of the charge. We conjecture the general form of the non-perturbative behavior of the conformal dimensions for any value of N and find very good agreement with previous lattice data.","abstract_source_suggest":{"input":"Springer"}},{"source":"arXiv","value":"We study the O(2N) model at criticality in three dimensions in the double scaling limit of large N and large charge. We show that the large-charge expansion is an asymptotic series, and we use resurgence techniques to study the non-perturbative corrections and to extend the validity of the effective field theory to any value of the charge. We conjecture the general form of the non-perturbative behavior of the conformal dimensions for any value of N and find very good agreement with previous lattice data.","abstract_source_suggest":{"input":"arXiv"}}],"control_number":1848464,"dois":[{"source":"bibmatch","value":"10.1007/JHEP05(2021)035"},{"material":"publication","source":"arXiv","value":"10.1007/JHEP05(2021)035"}],"preprint_date":"2021-02-24","arxiv_eprints":[{"categories":["hep-th"],"value":"2102.12488"}],"titles":[{"source":"arXiv","title":"Resurgence of the large-charge expansion"}],"document_type":["article"]},"id":"1848464"}],"total":1},"links":{"self":"https://inspirehep.net/api/literature/?q=arxiv%3A2102.12488&size=5&page=1&fields=titles,authors,dois,publication_info,arxiv_eprints,document_type,preprint_date,imprints,abstracts,urls","bibtex":"https://inspirehep.net/api/literature/?q=arxiv%3A2102.12488&size=5&page=1&format=bibtex","latex-eu":"https://inspirehep.net/api/literature/?q=arxiv%3A2102.12488&size=5&page=1&format=latex-eu","latex-us":"https://inspirehep.net/api/literature/?q=arxiv%3A2102.12488&size=5&page=1&format=latex-us","json":"https://inspirehep.net/api/literature/?q=arxiv%3A2102.12488&size=5&page=1&fields=titles,authors,dois,publication_info,arxiv_eprints,document_type,preprint_date,imprints,abstracts,urls&format=json","json-expanded":"https://inspirehep.net/api/literature/?q=arxiv%3A2102.12488&size=5&page=1&format=json-expanded","cv":"https://inspirehep.net/api/literature/?q=arxiv%3A2102.12488&size=5&page=1&format=cv"}}