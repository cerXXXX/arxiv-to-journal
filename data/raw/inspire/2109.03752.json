d":996548}],"imprints":[{"date":"2021-11-04"}],"abstracts":[{"source":"Springer","value":"We assume that the points in volumes smaller than an elementary volume (which may have a Planck size) are indistinguishable in any physical experiment. This naturally leads to a picture of a discrete space with a finite number of degrees of freedom per elementary volume. In such discrete spaces, each elementary cell is completely characterized by displacement operators connecting a cell to the neighboring cells and by the spin connection. We define the torsion and curvature of the discrete spaces and show that in the limiting case of vanishing elementary volume the standard results for the continuous curved differentiable manifolds are completely reproduced.","abstract_source_suggest":{"input":"Springer"}},{"source":"arXiv","value":"We assume that the points in volumes smaller than an elementary volume (which may have a Planck size) are indistinguishable in any physical experiment. This naturally leads to a picture of a discrete space with a finite number of degrees of freedom per elementary volume. In such discrete spaces, each elementary cell is completely characterized by displacement operators connecting a cell to the neighboring cells and by the spin connection. We define the torsion and curvature of the discrete spaces and show that in the limiting case of vanishing elementary volume the standard results for the continuous curved differentiable manifolds are completely reproduced.","abstract_source_suggest":{"input":"arXiv"}}],"control_number":1918503,"dois":[{"source":"Springer","value":"10.1007/JHEP11(2021)013"},{"material":"publication","source":"arXiv","value":"10.1007/JHEP11(2021)013"}],"preprint_date":"2021-09-08","arxiv_eprints":[{"categories":["hep-th","gr-qc","hep-lat"],"value":"2109.03752"}],"titles":[{"source":"Springer","title":"Discrete gravity"},{"source":"arXiv","title":"Discrete Gravity"}],"document_type":["article"]},"id":"1918503","links":{"bibtex":"http