INSPIRE BAI","value":"K.Kuroda.1"}],"signature_block":"CARADk","first_name":"Kohei","recid":1001484},{"raw_affiliations":[{"value":"Beijing Institute of Mathematical Sciences and Applications (BIMSA), 101408 Beijing, China"},{"value":"Nordita, KTH Royal Institute of Technology and Stockholm University, Roslagstullsbacken 23, SE-106 91 Stockholm, Sweden"}],"full_name_unicode_normalized":"shu, hongfei","last_name":"Shu","affiliations":[{"record":{"$ref":"https://inspirehep.net/api/institutions/903077"},"value":"Nordita"},{"record":{"$ref":"https://inspirehep.net/api/institutions/903171"},"value":"Royal Inst. Tech., Stockholm"}],"uuid":"5a59da88-a4e5-47d4-8edc-349ca553775b","affiliations_identifiers":[{"schema":"GRID","value":"grid.10548.38"},{"schema":"ROR","value":"https://ror.org/03r06fs10"},{"schema":"ROR","value":"https://ror.org/026vcq606"}],"full_name":"Shu, Hongfei","record":{"$ref":"https://inspirehep.net/api/authors/1609928"},"ids":[{"schema":"ORCID","value":"0000-0003-1890-7762"},{"schema":"INSPIRE BAI","value":"Hongfei.Shu.1"}],"signature_block":"Sh","first_name":"Hongfei","recid":1609928}],"publication_info":[{"journal_volume":"10","artid":"167","year":2021,"journal_record":{"$ref":"https://inspirehep.net/api/journals/1213103"},"page_start":"167","journal_title":"JHEP"},{"pubinfo_freetext":"JHEP10(2021)167","material":"publication"}],"imprints":[{"date":"2021-10-20"}],"abstracts":[{"source":"Springer","value":"We study the WKB periods for the (r + 1)-th order ordinary differential equation (ODE) which is obtained by the conformal limit of the linear problem associated with the $ {A}_r^{(1)} $ affine Toda field equation. We compute the quantum corrections by using the Picard-Fuchs operators. The ODE/IM correspondence provides a relation between the Wronskians of the solutions and the Y-functions which satisfy the thermodynamic Bethe ansatz (TBA) equation related to the Lie algebra A$_{r}$. For the quadratic potential, we propose a formula to show the equivalence between the logarithm of the Y-function and the WKB period, which is confirmed by solving the TBA equation numerically.","abstract_source_suggest":{"input":"Springer"}},{"source":"arXiv","value":"We study the WKB periods for the $(r+1)$-th order ordinary differential equation (ODE) which is obtained by the conformal limit of the linear problem associated with the $A_r^{(1)}$ affine Toda field equation. We compute the quantum corrections by using the Picard-Fuchs operators. The ODE/IM correspondence provides a relation between the Wronskians of the solutions and the Y-functions which satisfy the thermodynamic Bethe ansatz (TBA) equation related to the Lie algebra $A_r$. For the quadratic potential, we propose a formula to show the equivalence between the logarithm of the Y-function and the WKB period, which is confirmed by solving the TBA equation numerically.","abstract_source_suggest":{"input":"arXiv"}}],"control_number":1861153,"dois":[{"source":"Springer","value":"10.1007/JHEP10(2021)167"},{"material":"publication","source":"arXiv","value":"10.1007/JHEP10(2021)167"}],"preprint_date":"2021-04-28","arxiv_eprints":[{"categories":["hep-th","math-ph","math.MP"],"value":"2104.13680"}],"titles":[{"source":"Springer","title":"WKB periods for higher order ODE and TBA equations"},{"source":"arXiv","title":"WKB periods for higher order ODE and TBA equations"}],"document_type":["article"]},"updated":"2023-10-03T08:37:21.184344+00:00","links":{"bibtex":"https://inspirehep.net/api/literature/1861153?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/1861153?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/1861153?format=latex-us","json":"https://inspirehep.net/api/literature/1861153?format=json","json-expanded":"https://inspirehep.net/api/literature/1861153?format=json-expanded","cv":"https://inspirehep.net/api/literature/1861153?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A1861153"},"id":"1861153"}],