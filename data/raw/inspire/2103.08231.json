iations":[{"value":"Okinawa Institute of Science and Technology, 1919-1 Tancha, Onna-son, Okinawa 904-0495, Japan"}],"full_name_unicode_normalized":"weissman, dorin","last_name":"Weissman","affiliations":[{"record":{"$ref":"https://inspirehep.net/api/institutions/1281975"},"value":"Okinawa Inst. Sci. Tech."}],"uuid":"df2bcad4-f5dd-47a0-aa02-ed27e4b9d23d","full_name":"Weissman, Dorin","curated_relation":true,"record":{"$ref":"https://inspirehep.net/api/authors/1670781"},"ids":[{"schema":"INSPIRE BAI","value":"D.Weissman.1"}],"signature_block":"WASNANd","first_name":"Dorin","recid":1670781}],"publication_info":[{"journal_volume":"967","pubinfo_freetext":"Nucl. Phys. B 967 (2021) 115427","artid":"115427","material":"publication","year":2021,"journal_title":"Nucl.Phys.B"}],"imprints":[{"date":"2021-06"}],"abstracts":[{"source":"arXiv","value":"Using the BRST approach to higher spin field theories we develop a generic technique for constructing the cubic interaction vertices for N=1 supersymmetric massless higher spin fields on four, six and ten dimensional flat backgrounds. Such an approach allows formulation of the equations for cubic vertices including bosonic and fermionic higher spin fields, and the problem of finding the vertices is reduced to finding the consistent solutions to these equations. As a realization of this procedure, we present the particular solutions for the vertices where the fields obey some off-shell constraints. It is shown that the supersymmetry imposes additional constraints on the vertices and singles out a particular subclass of the solutions. As a concrete application of the generic scheme, we consider supersymmetric Yang-Mills-like systems in four, six and ten dimensions where the higher spin fields transform under some internal symmetry group, as well as supergravity-like systems in the same dimensions.","abstract_source_suggest":{"input":"arXiv"}}],"control_number":1851717,"dois":[{"material":"publication","source":"arXiv","value":"10.1016/j.nuclphysb.2021.115427"}],"preprint_date":"2021-03-15","arxiv_eprints":[{"categories":["hep-th"],"value":"2103.08231"}],"titles":[{"source":"arXiv","title":"Cubic Vertices for N=1 Supersymmetric Massless Higher Spin Fields in Various Dimensions"},{"source":"arXiv","title":"Cubic Vertices for $\\mathcal{N}$ = 1 Supersymmetric Massless Higher Spin Fields in Various Dimensions"}],"document_type":["article"]},"links":{"bibtex":"https://inspirehep.net/api/literature/1851717?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/1851717?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/1851717?format=latex-us","json":"https://inspirehep.net/api/literature/1851717?format=json","json-expanded":"https://inspirehep.net/api/literature/1851717?format=json-expanded","cv":"https://inspirehep.net/api/literature/1851717?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A1851717"},"updated":"2023-10-03T08:54:07.396479+00:00","created":"2021-03-16T00:00:00+00:00"}],"total":1},"links":{"self":"https://inspirehep.net/api/literature/?q=arxiv%3A2103.08231&size=5&page=1&fields=titles,authors,dois,publication_info,arxiv_eprints,document_type,preprint_date,imprints,abstracts,urls","bibtex":"https://inspirehep.net/api/literature/?q=arxiv%3A2103.08231&size=5&page=1&format=bibtex","latex-eu":"https://inspirehep.net/api/literature/?q=arxiv%3A2103.08231&size=5&page=1&format=latex-eu","latex-us":"https://inspirehep.net/api/literature/?q=arxiv%3A2103.08231&size=5&page=1&format=latex-us","json":"https://inspirehep.net/api/literature/?q=arxiv%3A2103.08231&size=5&page=1&fields=titles,authors,dois,publication_info,arxiv_eprints,document_type,preprint_date,imprints,abstracts,urls&format=json","json-expanded":"https://inspirehep.net/api/literature/?q=arxiv%3A2103.08231&size=5&page=1&format=json-expanded","cv":"https://inspirehep.net/api/literature/?q=arxiv%3A2103.08231&size=5&page=1&format=cv"}}