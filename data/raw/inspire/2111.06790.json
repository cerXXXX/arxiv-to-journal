normalized":"oles, k.","affiliations":[{"curated_relation":true,"record":{"$ref":"https://inspirehep.net/api/institutions/902897"},"value":"Jagiellonian U."}],"last_name":"Oles","uuid":"5391c0b1-38d4-4529-b53a-4e4c26cdbd2e","affiliations_identifiers":[{"schema":"ROR","value":"https://ror.org/03bqmcz70"}],"full_name":"Oles, K.","curated_relation":true,"record":{"$ref":"https://inspirehep.net/api/authors/1809585"},"ids":[{"schema":"ORCID","value":"0000-0001-6821-9904"},{"schema":"INSPIRE BAI","value":"Katarzyna.Oles.1"}],"signature_block":"OLk","first_name":"K.","recid":1809585},{"raw_affiliations":[{"source":"APS","value":"Institute of Theoretical Physics, Jagiellonian University, Lojasiewicza 11, Kraków 30-348, Poland"}],"affiliations_identifiers":[{"schema":"ROR","value":"https://ror.org/03bqmcz70"}],"full_name_unicode_normalized":"romanczukiewicz, t.","full_name":"Romanczukiewicz, T.","record":{"$ref":"https://inspirehep.net/api/authors/1057157"},"affiliations":[{"curated_relation":true,"record":{"$ref":"https://inspirehep.net/api/institutions/902897"},"value":"Jagiellonian U."}],"ids":[{"schema":"INSPIRE BAI","value":"T.Romanczukiewicz.1"}],"last_name":"Romanczukiewicz","signature_block":"RANANCSACACt","first_name":"T.","uuid":"288ac865-5acd-4d40-826c-60a3221eb854","recid":1057157},{"raw_affiliations":[{"source":"APS","value":"Institute of Theoretical Physics, Jagiellonian University, Lojasiewicza 11, Kraków 30-348, Poland"}],"full_name_unicode_normalized":"wereszczynski, a.","affiliations":[{"curated_relation":true,"record":{"$ref":"https://inspirehep.net/api/institutions/902897"},"value":"Jagiellonian U."}],"last_name":"Wereszczynski","uuid":"5ab8ea53-6957-4eae-bbab-473b600ce809","affiliations_identifiers":[{"schema":"ROR","value":"https://ror.org/03bqmcz70"}],"full_name":"Wereszczynski, A.","curated_relation":true,"record":{"$ref":"https://inspirehep.net/api/authors/1029432"},"ids":[{"schema":"ORCID","value":"0000-0002-0353-4812"},{"schema":"INSPIRE BAI","value":"Andrzej.Wereszczynski.1"}],"signature_block":"WARASCSANSCa","first_name":"A.","recid":1029432}],"imprints":[{"date":"2022-03-15"}],"abstracts":[{"source":"APS","value":"The moduli space approximation to kink dynamics permits a relativistic generalization if the Derrick scaling parameter is used as a collective coordinate. We develop a perturbative approach to the resulting relativistic moduli space by expanding the Derrick scaling parameter about unity and treating the higher-order Derrick modes as new degrees of freedom. This approach allows us to resolve (coordinate) singularities order by order and systematically incorporates relativistic corrections perturbatively in kink scattering. It gives an excellent description of kink-antikink collisions in <math display=\"inline\"><msup><mi>ϕ</mi><mn>4</mn></msup></math> field theory already at first order and at higher order reproduces the fractal structure in the formation of the final state with an error of only 4%.","abstract_source_suggest":{"input":"APS"}},{"source":"arXiv","value":"The moduli space approximation to kink dynamics permits a relativistic generalization if the Derrick scaling parameter is used as a collective coordinate. We develop a perturbative approach to the resulting relativistic moduli space by expanding the Derrick scaling parameter about unity and treating the higher-order Derrick modes as new degrees of freedom. This approach allows us to resolve (coordinate) singularities order-by-order, and systematically incorporates relativistic corrections {\\it perturbatively} in kink scattering. It gives an excellent description of kink-antikink collisions in $\\phi^4$ field theory already at first order, and at higher order, reproduces the fractal structure in the formation of the final state with an error of only $4\\%$.","abstract_source_suggest":{"input":"arXiv"}}],"control_number":1967145,"dois":[{"material":"publication","source":"APS","value":"10.1103/PhysRevD.105.065012"},{"material":"publication","source":"arXiv","value":"10.1103/PhysRevD.105.065012"}],"preprint_date":"2021-11-12","arxiv_eprints":[{"categories":["hep-th","math-ph","math.MP"],"value":"2111.06790"}],"titles":[{"source":"APS","title":"Relativistic moduli space for kink collisions"},{"source":"arXiv","title":"Relativistic Moduli Space for Kink Collisions"}],"document_type":["article"]},"created":"2021-11-15T02:40:54.609684+00:00","id":"1967145","updated":"2025-03-04T08:44:19.118446+00:00","links":{"bibtex":"https://inspirehep.net/api/literature/1967145?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/1967145?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/1967145?format=latex-us","json":"https://inspirehep.net/api/literature/1967145?format=json","json-expanded":"https://inspirehep.net/api/literature/1967145?format=json-expanded","cv":"https://inspirehep.net/api/literature/1967145?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A1967145"}}],"total":1},"links":{"self":"https://inspirehep.net/api/literature/?q=arxiv%3A2111.06790&size=5&page=1&fields=titles,authors,dois,publication_info,arxiv_eprints,document_type,preprint_date,imprints,abstracts,urls","bibtex":"https://inspirehep.net/api/literature/?q=arxiv%3A2111.06790&size=5&page=1&format=bibtex","latex-eu":"https://inspirehep.net/api/literature/?q=arxiv%3A2111.06790&size=5&page=1&format=latex-eu","latex-us":"https://inspirehep.net/api/literature/?q=arxiv%3A2111.06790&size=5&page=1&format=latex-us","json":"https://inspirehep.net/api/literature/?q=arxiv%3A2111.06790&size=5&page=1&fields=titles,authors,dois,publication_info,arxiv_eprints,document_type,preprint_date,imprints,abstracts,urls&format=json","json-expanded":"https://inspirehep.net/api/literature/?q=arxiv%3A2111.06790&size=5&page=1&format=json-expanded","cv":"https://inspirehep.net/api/literature/?q=arxiv%3A2111.06790&size=5&page=1&format=cv"}}