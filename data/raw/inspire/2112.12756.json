/authors/2847745"},"ids":[{"schema":"INSPIRE BAI","value":"Donald.Huber.Youmans.1"}],"signature_block":"YANANd","first_name":"Donald R.","recid":2847745}],"imprints":[{"date":"2022-09-17"},{"date":"2022-12-08"}],"abstracts":[{"source":"Springer","value":"We study an enhanced version of the Morse degeneration of Fukaya $A_\\infty $ category with higher compositions given by numbers of gradient flow trees. The enhancement consists in allowing morphisms from an object to itself to be chains on the manifold. Higher compositions correspond to counting Morse trees passing through a given set of chains. We provide two viewpoints on the construction and on the proof of the $A_\\infty $ relations for the composition maps. One viewpoint is via an effective action for the BF theory computed in a special gauge. The other is via higher topological quantum mechanics.","abstract_source_suggest":{"input":"Springer"}},{"source":"arXiv","value":"We study an enhanced version of the Morse degeneration of Fukaya $A_\\infty$ category with higher compositions given by counts of gradient flow trees. The enhancement consists in allowing morphisms from an object to itself to be chains on the manifold. Higher compositions correspond to counting Morse trees passing through a given set of chains. We provide two viewpoints on the construction and on the proof of the $A_\\infty$ relations for the composition maps. One viewpoint is via an effective action for the $BF$ theory computed in a special gauge. The other is via higher topological quantum mechanics.","abstract_source_suggest":{"input":"arXiv"}}],"control_number":1996569,"dois":[{"source":"Springer","value":"10.1007/s11005-022-01587-2"},{"source":"Springer","value":"10.1007/s11005-022-01622-2"},{"material":"publication","source":"arXiv","value":"10.1007/s11005-022-01622-2"}],"preprint_date":"2021-12-23","arxiv_eprints":[{"categories":["hep-th","math-ph","math.MP"],"value":"2112.12756"}],"titles":[{"source":"Springer","title":"Two field-theo